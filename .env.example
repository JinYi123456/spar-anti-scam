# ── SPAR environment ─────────────────────────────────────────
# Copy this file to .env.local and fill in your key.
# Without it, SPAR runs in Offline Forensics Mode (still fully functional).

# Featherless AI — https://featherless.ai (OpenAI-compatible endpoint)
FEATHERLESS_API_KEY=

# Optional overrides
# FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V3-0324
